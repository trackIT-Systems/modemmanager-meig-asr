diff --git a/src/plugins/asr/tests/test-modem-helpers-asr.c b/src/plugins/asr/tests/test-modem-helpers-asr.c
index 5c91c39c..7d7abca4 100644
--- a/src/plugins/asr/tests/test-modem-helpers-asr.c
+++ b/src/plugins/asr/tests/test-modem-helpers-asr.c
@@ -369,6 +369,43 @@ test_authreq (void)
 
 /*****************************************************************************/
 
+typedef struct {
+    const gchar *response;
+    guint        cid;
+    gboolean     connected;
+} EcmdupTest;
+
+static const EcmdupTest ecmdup_tests[] = {
+    { "\r\nOK\r\n", 1, FALSE },
+    { "\r\n+ECMDUP: 1,1,\"IPV4\",0,\"IPV6\"\r\n\r\nOK\r\n", 1, TRUE },
+    { "\r\n+ECMDUP: 1,1,\"IPV4\",2,\"IPV6\"\r\n\r\nOK\r\n", 1, TRUE },
+    { "\r\n+ECMDUP: 1,1,\"IPV4\",2,\"IPV6\"\r\n\r\nOK\r\n", 2, FALSE },
+    { "\r\n+ECMDUP: 2,0,\"IPV4\",1,\"IPV6\"\r\n\r\nOK\r\n", 2, TRUE },
+    { "\r\n+ECMDUP: 2,0,\"IPV4\",0,\"IPV6\"\r\n\r\nOK\r\n", 2, FALSE },
+    { "+ECMDUP: 1,1,\"IPV4\"", 1, TRUE },
+    { "\r\n+ECMDUP: 1,0,\"IPV4\",0,\"IPV6\"\r\n+ECMDUP: 3,1,\"IPV4\",0,\"IPV6\"\r\n\r\nOK\r\n", 3, TRUE },
+};
+
+static void
+test_ecmdup (void)
+{
+    guint i;
+
+    for (i = 0; i < G_N_ELEMENTS (ecmdup_tests); i++) {
+        g_autoptr(GError) error = NULL;
+        gboolean          connected = TRUE;
+        gboolean          success;
+
+        success = mm_asr_parse_ecmdup_read_response (ecmdup_tests[i].response,
+                                                     ecmdup_tests[i].cid,
+                                                     &connected,
+                                                     &error);
+        g_assert_no_error (error);
+        g_assert_true (success);
+        g_assert_cmpint (connected, ==, ecmdup_tests[i].connected);
+    }
+}
+
 int
 main (int argc, char **argv)
 {
@@ -380,6 +417,7 @@ main (int argc, char **argv)
     g_test_add_func ("/MM/asr/cgcontrdp_line", test_cgcontrdp_line);
     g_test_add_func ("/MM/asr/cgcontrdp", test_cgcontrdp);
     g_test_add_func ("/MM/asr/authreq", test_authreq);
+    g_test_add_func ("/MM/asr/ecmdup", test_ecmdup);
 
     return g_test_run ();
 }
