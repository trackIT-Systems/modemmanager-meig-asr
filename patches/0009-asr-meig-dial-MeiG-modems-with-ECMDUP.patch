 src/plugins/asr/mm-broadband-modem-asr.h      |   1 +
 src/plugins/asr/mm-modem-helpers-asr.c        |  54 ++++
 src/plugins/asr/mm-modem-helpers-asr.h        |   6 +
 .../asr/tests/test-modem-helpers-asr.c        |  38 +++
 .../meig/mm-broadband-modem-meig-asr.c        |   1 +
 8 files changed, 345 insertions(+), 10 deletions(-)

diff --git a/src/plugins/asr/mm-broadband-bearer-asr.c b/src/plugins/asr/mm-broadband-bearer-asr.c
index 017dbd28..e04bf2d4 100644
--- a/src/plugins/asr/mm-broadband-bearer-asr.c
+++ b/src/plugins/asr/mm-broadband-bearer-asr.c
@@ -29,6 +29,7 @@ G_DEFINE_TYPE (MMBroadbandBearerAsr, mm_broadband_bearer_asr, MM_TYPE_BROADBAND_
 enum {
     PROP_0,
     PROP_DEFAULT_IP_METHOD,
+    PROP_ECM_DIAL,
     PROP_LAST
 };
 
@@ -36,6 +37,7 @@ static GParamSpec *properties[PROP_LAST];
 
 struct _MMBroadbandBearerAsrPrivate {
     MMBearerIpMethod default_ip_method;
+    gboolean         ecm_dial;
 };
 
 /*****************************************************************************/
@@ -46,6 +48,7 @@ typedef enum {
     DIAL_3GPP_STEP_REDEFINE_PDP_CONTEXT,
     DIAL_3GPP_STEP_AUTHENTICATE,
     DIAL_3GPP_STEP_ACTIVATE,
+    DIAL_3GPP_STEP_ECM_DIAL,
     DIAL_3GPP_STEP_LAST,
 } CustomInitStep;
 
@@ -170,11 +173,47 @@ dial_3gpp_step (GTask *task)
     }
 
     case DIAL_3GPP_STEP_ACTIVATE:
+        /* +ECMDUP activates the context itself; activating it with +CGACT
+         * first makes the following +ECMDUP fail */
+        if (self->priv->ecm_dial) {
+            ctx->step++;
+            dial_3gpp_step (task);
+            return;
+        }
         cmd = g_strdup_printf ("+CGACT=1,%u", ctx->cid);
         mm_obj_dbg (self, "activating context #%u...", ctx->cid);
         mm_base_modem_at_command (ctx->modem, cmd, MM_BASE_BEARER_DEFAULT_CONNECTION_TIMEOUT, FALSE, (GAsyncReadyCallback) dial_3gpp_command_ready, task);
         return;
 
+    case DIAL_3GPP_STEP_ECM_DIAL: {
+        MMBearerIpFamily  ip_family;
+        guint             pdp_type;
+        g_autofree gchar *quoted_apn = NULL;
+
+        if (!self->priv->ecm_dial) {
+            ctx->step++;
+            dial_3gpp_step (task);
+            return;
+        }
+
+        /* +ECMDUP activates the context and connects it to the network
+         * interface (pdp type 0: IPv4, 1: IPv6, 2: IPv4v6). Authentication
+         * was already set up with *AUTHREQ. */
+        ip_family = mm_3gpp_profile_get_ip_type (ctx->profile);
+        if (ip_family == MM_BEARER_IP_FAMILY_IPV6)
+            pdp_type = 1;
+        else if (ip_family == MM_BEARER_IP_FAMILY_IPV4V6)
+            pdp_type = 2;
+        else
+            pdp_type = 0;
+
+        quoted_apn = mm_at_quote_string (mm_3gpp_profile_get_apn (ctx->profile));
+        cmd = g_strdup_printf ("+ECMDUP=%u,1,%u,%s", ctx->cid, pdp_type, quoted_apn);
+        mm_obj_dbg (self, "activating context #%u and connecting it to the network interface...", ctx->cid);
+        mm_base_modem_at_command (ctx->modem, cmd, MM_BASE_BEARER_DEFAULT_CONNECTION_TIMEOUT, FALSE, (GAsyncReadyCallback) dial_3gpp_command_ready, task);
+        return;
+    }
+
     case DIAL_3GPP_STEP_LAST:
         g_task_return_pointer (task, g_object_ref (ctx->data), g_object_unref);
         g_object_unref (task);
@@ -460,15 +499,70 @@ cgact_deactivate_ready (MMBaseModem  *modem,
                         GAsyncResult *res,
                         GTask        *task)
 {
-    GError *error = NULL;
+    MMBroadbandBearerAsr *self;
+    GError               *error = NULL;
 
-    if (!mm_base_modem_at_command_finish (modem, res, &error))
-        g_task_return_error (task, error);
-    else
-        g_task_return_boolean (task, TRUE);
+    self = g_task_get_source_object (task);
+
+    if (!mm_base_modem_at_command_finish (modem, res, &error)) {
+        /* With +ECMDUP the connection is already gone; the context may stay
+         * active, e.g. if it is the LTE default bearer */
+        if (!self->priv->ecm_dial) {
+            g_task_return_error (task, error);
+            g_object_unref (task);
+            return;
+        }
+        mm_obj_dbg (self, "couldn't deactivate PDP context: %s", error->message);
+        g_error_free (error);
+    }
+    g_task_return_boolean (task, TRUE);
     g_object_unref (task);
 }
 
+typedef struct {
+    MMBaseModem *modem;
+    guint        cid;
+} DisconnectContext;
+
+static void
+disconnect_context_free (DisconnectContext *ctx)
+{
+    g_object_unref (ctx->modem);
+    g_slice_free (DisconnectContext, ctx);
+}
+
+static void
+cgact_deactivate (GTask *task)
+{
+    DisconnectContext *ctx;
+    g_autofree gchar  *cmd = NULL;
+
+    ctx = g_task_get_task_data (task);
+
+    cmd = g_strdup_printf ("+CGACT=0,%u", ctx->cid);
+    mm_obj_dbg (g_task_get_source_object (task), "deactivating PDP context #%u...", ctx->cid);
+    mm_base_modem_at_command (ctx->modem,
+                              cmd,
+                              MM_BASE_BEARER_DEFAULT_DISCONNECTION_TIMEOUT,
+                              FALSE,
+                              (GAsyncReadyCallback) cgact_deactivate_ready,
+                              task);
+}
+
+static void
+ecmdup_disconnect_ready (MMBaseModem  *modem,
+                         GAsyncResult *res,
+                         GTask        *task)
+{
+    g_autoptr(GError) error = NULL;
+
+    /* Not fatal: the modem may already have ended the connection itself */
+    if (!mm_base_modem_at_command_finish (modem, res, &error))
+        mm_obj_dbg (g_task_get_source_object (task), "couldn't disconnect from the network interface: %s", error->message);
+
+    cgact_deactivate (task);
+}
+
 static void
 disconnect_3gpp (MMBroadbandBearer   *self,
                  MMBroadbandModem    *modem,
@@ -479,18 +573,116 @@ disconnect_3gpp (MMBroadbandBearer   *self,
                  GAsyncReadyCallback  callback,
                  gpointer             user_data)
 {
-    GTask            *task;
-    g_autofree gchar *cmd = NULL;
+    GTask             *task;
+    DisconnectContext *ctx;
+    g_autofree gchar  *cmd = NULL;
+
+    ctx        = g_slice_new0 (DisconnectContext);
+    ctx->modem = MM_BASE_MODEM (g_object_ref (modem));
+    ctx->cid   = cid;
 
     task = g_task_new (self, NULL, callback, user_data);
+    g_task_set_task_data (task, ctx, (GDestroyNotify) disconnect_context_free);
 
-    cmd = g_strdup_printf ("+CGACT=0,%u", cid);
-    mm_obj_dbg (self, "deactivating PDP context #%u...", cid);
+    if (!MM_BROADBAND_BEARER_ASR (self)->priv->ecm_dial) {
+        cgact_deactivate (task);
+        return;
+    }
+
+    cmd = g_strdup_printf ("+ECMDUP=%u,0", cid);
+    mm_obj_dbg (self, "disconnecting context #%u from the network interface...", cid);
     mm_base_modem_at_command (MM_BASE_MODEM (modem),
                               cmd,
                               MM_BASE_BEARER_DEFAULT_DISCONNECTION_TIMEOUT,
                               FALSE,
-                              (GAsyncReadyCallback) cgact_deactivate_ready,
+                              (GAsyncReadyCallback) ecmdup_disconnect_ready,
+                              task);
+}
+
+/*****************************************************************************/
+/* Connection status monitoring */
+
+static MMBearerConnectionStatus
+load_connection_status_finish (MMBaseBearer  *self,
+                               GAsyncResult  *res,
+                               GError       **error)
+{
+    GError *inner_error = NULL;
+    gssize  value;
+
+    if (!MM_BROADBAND_BEARER_ASR (self)->priv->ecm_dial)
+        return MM_BASE_BEARER_CLASS (mm_broadband_bearer_asr_parent_class)->load_connection_status_finish (self, res, error);
+
+    value = g_task_propagate_int (G_TASK (res), &inner_error);
+    if (inner_error) {
+        g_propagate_error (error, inner_error);
+        return MM_BEARER_CONNECTION_STATUS_UNKNOWN;
+    }
+    return (MMBearerConnectionStatus) value;
+}
+
+static void
+ecmdup_query_ready (MMBaseModem  *modem,
+                    GAsyncResult *res,
+                    GTask        *task)
+{
+    MMBaseBearer *self;
+    const gchar  *response;
+    GError       *error = NULL;
+    gboolean      connected = FALSE;
+
+    self = g_task_get_source_object (task);
+
+    response = mm_base_modem_at_command_finish (modem, res, &error);
+    if (!response) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    if (!mm_asr_parse_ecmdup_read_response (response,
+                                            (guint) mm_base_bearer_get_profile_id (self),
+                                            &connected,
+                                            &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    g_task_return_int (task, connected ? MM_BEARER_CONNECTION_STATUS_CONNECTED : MM_BEARER_CONNECTION_STATUS_DISCONNECTED);
+    g_object_unref (task);
+}
+
+static void
+load_connection_status (MMBaseBearer        *self,
+                        GAsyncReadyCallback  callback,
+                        gpointer             user_data)
+{
+    GTask                  *task;
+    g_autoptr(MMBaseModem)  modem = NULL;
+
+    /* The context stays active when the modem drops the +ECMDUP connection,
+     * so +CGACT? can't tell; ask +ECMDUP? instead */
+    if (!MM_BROADBAND_BEARER_ASR (self)->priv->ecm_dial) {
+        MM_BASE_BEARER_CLASS (mm_broadband_bearer_asr_parent_class)->load_connection_status (self, callback, user_data);
+        return;
+    }
+
+    task = g_task_new (self, NULL, callback, user_data);
+
+    if (mm_base_bearer_get_profile_id (self) == MM_3GPP_PROFILE_ID_UNKNOWN) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "Couldn't load connection status: cid not defined");
+        g_object_unref (task);
+        return;
+    }
+
+    g_object_get (self, MM_BASE_BEARER_MODEM, &modem, NULL);
+    mm_base_modem_at_command (modem,
+                              "+ECMDUP?",
+                              3,
+                              FALSE,
+                              (GAsyncReadyCallback) ecmdup_query_ready,
                               task);
 }
 
