 }
+
+/*****************************************************************************/
+/* +ECMDUP? response parser
+ *
+ * One line per connection, e.g.:
+ *   +ECMDUP: 1,1,"IPV4",2,"IPV6"
+ * with the cid followed by the IPv4 and IPv6 states (1: connected). No line
+ * at all if nothing is connected. */
+
+gboolean
+mm_asr_parse_ecmdup_read_response (const gchar  *response,
+                                   guint         cid,
+                                   gboolean     *out_connected,
+                                   GError      **error)
+{
+    g_autoptr(GRegex)     r = NULL;
+    g_autoptr(GMatchInfo) match_info = NULL;
+    g_autoptr(GError)     inner_error = NULL;
+
+    g_assert (out_connected);
+    *out_connected = FALSE;
+
+    r = g_regex_new ("\\+ECMDUP:\\s*(\\d+)\\s*,\\s*(\\d+)\\s*,\\s*\"[^\"]*\"\\s*(?:,\\s*(\\d+))?",
+                     G_REGEX_RAW, 0, NULL);
+    g_assert (r != NULL);
+
+    g_regex_match_full (r, response, strlen (response), 0, 0, &match_info, &inner_error);
+    while (!inner_error && g_match_info_matches (match_info)) {
+        guint line_cid = 0;
+        guint ipv4_state = 0;
+        guint ipv6_state = 0;
+
+        if (!mm_get_uint_from_match_info (match_info, 1, &line_cid) ||
+            !mm_get_uint_from_match_info (match_info, 2, &ipv4_state)) {
+            g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                         "Couldn't parse +ECMDUP response: '%s'", response);
+            return FALSE;
+        }
+        /* the IPv6 state is optional */
+        mm_get_uint_from_match_info (match_info, 3, &ipv6_state);
+
+        if (line_cid == cid && (ipv4_state == 1 || ipv6_state == 1)) {
+            *out_connected = TRUE;
+            return TRUE;
+        }
+        g_match_info_next (match_info, &inner_error);
+    }
+
+    if (inner_error) {
+        g_propagate_error (error, g_steal_pointer (&inner_error));
+        return FALSE;
+    }
+    return TRUE;
+}
