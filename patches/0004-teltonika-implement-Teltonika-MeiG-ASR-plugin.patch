+
+#include "mm-plugin.h"
+#include <gmodule.h>
+
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-log-object.h"
+#include "mm-plugin-common.h"
+#include "mm-broadband-modem-meig-asr.h"
+
+#define MM_TYPE_PLUGIN_TELTONIKA_MEIG_ASR mm_plugin_teltonika_meig_asr_get_type ()
+MM_DEFINE_PLUGIN (TELTONIKA_MEIG_ASR, teltonika_meig_asr, TeltonikaMeigAsr)
+
+static MMBaseModem *
+create_modem (MMPlugin     *self,
+              const gchar  *uid,
+              const gchar  *physdev,
+              const gchar **drivers,
+              guint16       vendor,
+              guint16       product,
+              guint16       subsystem_vendor,
+              guint16       subsystem_device,
+              GList        *probes,
+              GError      **error)
+{
+    mm_obj_dbg (self, "MeiG-ASR based Teltonika modem found");
+    return MM_BASE_MODEM (mm_broadband_modem_meig_asr_new (uid,
+                                                           physdev,
+                                                           drivers,
+                                                           mm_plugin_get_name (self),
+                                                           vendor,
+                                                           product));
+}
+
+MM_PLUGIN_NAMED_CREATOR_SCOPE MMPlugin *
+mm_plugin_create_teltonika_meig_asr (void)
+{
+    static const gchar          *subsystems[] = { "tty", "net", NULL };
+    static const mm_uint16_pair  products[]   = {
+        { 0x1d12, 0x0102 }, /* Teltonika ALA440 */
+        { 0, 0 }
+    };
+
+    return MM_PLUGIN (
+        g_object_new (MM_TYPE_PLUGIN_TELTONIKA_MEIG_ASR,
+                      MM_PLUGIN_NAME,                MM_MODULE_NAME,
+                      MM_PLUGIN_ALLOWED_SUBSYSTEMS,  subsystems,
+                      MM_PLUGIN_ALLOWED_PRODUCT_IDS, products,
+                      MM_PLUGIN_ALLOWED_AT,          TRUE,
+                      NULL));
+}
+
+static void
+mm_plugin_teltonika_meig_asr_init (MMPluginTeltonikaMeigAsr *self)
+{
+}
+
+static void
+mm_plugin_teltonika_meig_asr_class_init (MMPluginTeltonikaMeigAsrClass *klass)
+{
+    MMPluginClass *plugin_class = MM_PLUGIN_CLASS (klass);
+
+    plugin_class->create_modem = create_modem;
+}
diff --git a/src/plugins/tests/test-udev-rules.c b/src/plugins/tests/test-udev-rules.c
index fe205a44..023e48a5 100644
--- a/src/plugins/tests/test-udev-rules.c
+++ b/src/plugins/tests/test-udev-rules.c
@@ -152,6 +152,14 @@ test_telit (void)
 }
 #endif
 
+#if defined ENABLE_PLUGIN_TELTONIKA_MEIG_ASR
+static void
+test_teltonika_meig_asr (void)
+{
+    common_test (TESTUDEVRULESDIR_TELTONIKA_MEIG_ASR);
+}
+#endif
+
 #if defined ENABLE_PLUGIN_MTK_LEGACY
 static void
 test_mtk_legacy (void)
@@ -269,6 +277,9 @@ int main (int argc, char **argv)
 #if defined ENABLE_PLUGIN_TELIT
     g_test_add_func ("/MM/test-udev-rules/telit", test_telit);
 #endif
+#if defined ENABLE_PLUGIN_TELTONIKA_MEIG_ASR
+    g_test_add_func ("/MM/test-udev-rules/teltonika-meig-asr", test_teltonika_meig_asr);
+#endif
 #if defined ENABLE_PLUGIN_MTK_LEGACY
     g_test_add_func ("/MM/test-udev-rules/mtk", test_mtk_legacy);
 #endif
