 static void
 test_nokia_icera (void)
@@ -231,6 +239,9 @@ int main (int argc, char **argv)
 #if defined ENABLE_PLUGIN_MBM
     g_test_add_func ("/MM/test-udev-rules/mbm", test_mbm);
 #endif
