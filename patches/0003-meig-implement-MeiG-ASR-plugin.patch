diff --git a/src/plugins/meig/77-mm-meig-port-types.rules b/src/plugins/meig/77-mm-meig-port-types.rules
new file mode 100644
index 00000000..f32dfa41
--- /dev/null
+++ b/src/plugins/meig/77-mm-meig-port-types.rules
@@ -0,0 +1,20 @@
+# do not edit this file, it will be overwritten on update
+
+ACTION!="add|change|move|bind", GOTO="mm_meig_end"
+SUBSYSTEMS=="usb", ATTRS{idVendor}=="2dee", GOTO="mm_meig_start"
+GOTO="mm_meig_end"
+
+LABEL="mm_meig_start"
+SUBSYSTEMS=="usb", ATTRS{bInterfaceNumber}=="?*", ENV{.MM_USBIFNUM}="$attr{bInterfaceNumber}"
+
+# MeiG SLM770A (ECM)
+#  ttyUSB0 (if #2): ASR DIAG port (ignore for now)
+#  ttyUSB1 (if #3): AT port
+#  ttyUSB2 (if #4): AT port
+#  ttyUSB3 (if #5): GPS data port
+ATTRS{idVendor}=="2dee", ATTRS{idProduct}=="4d58", ENV{.MM_USBIFNUM}=="02", SUBSYSTEM=="tty", ENV{ID_MM_PORT_IGNORE}="1"
+ATTRS{idVendor}=="2dee", ATTRS{idProduct}=="4d58", ENV{.MM_USBIFNUM}=="03", SUBSYSTEM=="tty", ENV{ID_MM_PORT_TYPE_AT_PRIMARY}="1"
+ATTRS{idVendor}=="2dee", ATTRS{idProduct}=="4d58", ENV{.MM_USBIFNUM}=="04", SUBSYSTEM=="tty", ENV{ID_MM_PORT_TYPE_AT_SECONDARY}="1"
+ATTRS{idVendor}=="2dee", ATTRS{idProduct}=="4d58", ENV{.MM_USBIFNUM}=="05", SUBSYSTEM=="tty", ENV{ID_MM_PORT_GPS}="1"
+
+LABEL="mm_meig_end"
diff --git a/src/plugins/meig/mm-plugin-meig-asr.c b/src/plugins/meig/mm-plugin-meig-asr.c
new file mode 100644
index 00000000..70c3e45d
--- /dev/null
+++ b/src/plugins/meig/mm-plugin-meig-asr.c
@@ -0,0 +1,80 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
