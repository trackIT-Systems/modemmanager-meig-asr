+ * GNU General Public License for more details:
+ *
+ * Copyright (C) 2026 TDT AG
+ */
+
+#include "mm-plugin.h"
+#include <gmodule.h>
+
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-log-object.h"
+#include "mm-broadband-modem-meig-asr.h"
+#include "mm-modem-helpers-meig.h"
+#include "mm-plugin-common.h"
+
+#define MM_TYPE_PLUGIN_MEIG_ASR mm_plugin_meig_asr_get_type ()
+MM_DEFINE_PLUGIN (MEIG_ASR, meig_asr, MeigAsr)
+
+static MMBaseModem *
+create_modem (MMPlugin     *self,
+              const gchar  *uid,
+              const gchar  *physdev,
+              const gchar **drivers,
+              guint16       vendor,
+              guint16       product,
+              guint16       subsystem_vendor,
+              guint16       subsystem_device,
+              GList        *probes,
+              GError      **error)
+{
+    mm_obj_dbg (self, "ASR based MeiG modem found");
+    return MM_BASE_MODEM (mm_broadband_modem_meig_asr_new (uid,
+                                                           physdev,
+                                                           drivers,
+                                                           mm_plugin_get_name (self),
+                                                           vendor,
+                                                           product));
+}
+
+MM_PLUGIN_NAMED_CREATOR_SCOPE MMPlugin *
+mm_plugin_create_meig_asr (void)
+{
+    static const gchar          *subsystems[] = { "tty", "net", NULL };
+    static const mm_uint16_pair  products[]   = {
+        { 0x2dee, 0x4d58 }, /* MeiG SLM770A */
+        { 0, 0 }
+    };
+
+    return MM_PLUGIN (
+        g_object_new (MM_TYPE_PLUGIN_MEIG_ASR,
+                      MM_PLUGIN_NAME,                MM_MODULE_NAME,
+                      MM_PLUGIN_ALLOWED_SUBSYSTEMS,  subsystems,
+                      MM_PLUGIN_ALLOWED_PRODUCT_IDS, products,
+                      MM_PLUGIN_ALLOWED_AT,          TRUE,
+                      NULL));
+}
+
+static void
+mm_plugin_meig_asr_init (MMPluginMeigAsr *self)
+{
+}
+
+static void
+mm_plugin_meig_asr_class_init (MMPluginMeigAsrClass *klass)
+{
+    MMPluginClass *plugin_class = MM_PLUGIN_CLASS (klass);
+
+    plugin_class->create_modem = create_modem;
+}
diff --git a/src/plugins/meson.build b/src/plugins/meson.build
index 789a25bf..8248eea0 100644
--- a/src/plugins/meson.build
+++ b/src/plugins/meson.build
@@ -712,6 +712,21 @@ if plugins_options['mbm']
   plugins_udev_rules += files('mbm/77-mm-ericsson-mbm.rules')
 endif
 
+# plugin: meig (asr)
+if plugins_options['meig-asr']
+  test_udev_rules_dir_c_args = ['-DTESTUDEVRULESDIR_MEIG_ASR="@0@"'.format(plugins_dir / 'meig')]
+  plugins_test_udev_rules_dir_c_args += test_udev_rules_dir_c_args
+
+  incs = plugins_incs + [meig_inc] + [asr_inc]
+
+  plugins += {'plugin-meig-asr': {
+    'plugin': true,
+    'module': {'sources': files('meig/mm-plugin-meig-asr.c'), 'include_directories': incs, 'c_args': test_udev_rules_dir_c_args + ['-DMM_MODULE_NAME="meig-asr"']},
+  }}
+
+  plugins_udev_rules += files('meig/77-mm-meig-port-types.rules')
+endif
+
 # plugin: motorola
 if plugins_options['motorola']
   sources = files(
diff --git a/src/plugins/mm-builtin-plugins.c b/src/plugins/mm-builtin-plugins.c
index c7f91633..ee555c31 100644
--- a/src/plugins/mm-builtin-plugins.c
+++ b/src/plugins/mm-builtin-plugins.c
@@ -73,6 +73,9 @@ MMPlugin *mm_plugin_create_longcheer (void);
 #if defined ENABLE_PLUGIN_MBM
 MMPlugin *mm_plugin_create_mbm (void);
 #endif
+#if defined ENABLE_PLUGIN_MEIG_ASR
+MMPlugin *mm_plugin_create_meig_asr (void);
+#endif
 #if defined ENABLE_PLUGIN_MOTOROLA
 MMPlugin *mm_plugin_create_motorola (void);
 #endif
@@ -211,6 +214,9 @@ mm_builtin_plugins_load (void)
 #if defined ENABLE_PLUGIN_MBM
     PREPEND_PLUGIN (mbm);
 #endif
+#if defined ENABLE_PLUGIN_MEIG_ASR
+    PREPEND_PLUGIN (meig_asr);
+#endif
 #if defined ENABLE_PLUGIN_MOTOROLA
     PREPEND_PLUGIN (motorola);
 #endif
