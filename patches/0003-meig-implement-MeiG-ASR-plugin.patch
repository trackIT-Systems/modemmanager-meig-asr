 meson_options.txt                            |  1 +
 src/plugins/meig/77-mm-meig-port-types.rules | 20 +++++
 src/plugins/meig/mm-plugin-meig-asr.c        | 80 ++++++++++++++++++++
 src/plugins/meson.build                      | 15 ++++
 src/plugins/mm-builtin-plugins.c             |  6 ++
 src/plugins/tests/test-udev-rules.c          | 11 +++
 7 files changed, 134 insertions(+)
 create mode 100644 src/plugins/meig/77-mm-meig-port-types.rules
 create mode 100644 src/plugins/meig/mm-plugin-meig-asr.c

diff --git a/meson.build b/meson.build
index dbcde306..59dd9bf5 100644
--- a/meson.build
+++ b/meson.build
@@ -345,6 +345,7 @@ plugins_options_reqs = {
   'linktop': {'available': true, 'shared': []},
   'longcheer': {'available': true, 'shared': []},
   'mbm': {'available': true, 'shared': []},
+  'meig-asr': {'available': true, 'shared': ['meig', 'asr']},
   'motorola': {'available': true, 'shared': []},
   'mtk-legacy': {'available': true, 'shared': mtk_shared_reqs},
   'mtk': {'available': true, 'shared': mtk_shared_reqs},
diff --git a/meson_options.txt b/meson_options.txt
index c0609fe8..9bf7f344 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -44,6 +44,7 @@ option('plugin_iridium', type: 'feature', value: 'auto', description: 'enable ir
 option('plugin_linktop', type: 'feature', value: 'auto', description: 'enable linktop plugin support')
 option('plugin_longcheer', type: 'feature', value: 'auto', description: 'enable longcheer plugin support')
 option('plugin_mbm', type: 'feature', value: 'auto', description: 'enable mbm plugin support')
