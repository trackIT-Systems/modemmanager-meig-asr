+        .has_ipv4  = FALSE,
+        .has_ipv6  = TRUE,
+        .ipv6_dns1 = "2a01:598:7ff:0:10:74:210:210",
+        .ipv6_dns2 = "2a01:598:7ff:0:10:74:210:211",
