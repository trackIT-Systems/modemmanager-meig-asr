+        .dns_secondary_address = "2a01:598:7ff:0:10:74:210:211",
+    },
+};
+
+static void
+test_cgcontrdp_line (void)
+{
+    guint i;
+
+    for (i = 0; i < G_N_ELEMENTS (cgcontrdp_response_line_tests); i++) {
+        gboolean          success;
+        GError           *error                 = NULL;
+        guint             cid                   = G_MAXUINT;
+        guint             bearer_id             = G_MAXUINT;
+        g_autofree gchar *apn                   = NULL;
+        g_autofree gchar *local_address         = NULL;
+        g_autofree gchar *gateway               = NULL;
+        g_autofree gchar *dns_primary_address   = NULL;
+        g_autofree gchar *dns_secondary_address = NULL;
+
+        success = mm_asr_parse_cgcontrdp_response_line (cgcontrdp_response_line_tests[i].line,
+                                                        &cid,
+                                                        &bearer_id,
+                                                        &apn,
+                                                        &local_address,
+                                                        &gateway,
+                                                        &dns_primary_address,
+                                                        &dns_secondary_address,
+                                                        &error);
+        g_assert_no_error (error);
+        g_assert (success);
+        g_assert_cmpuint (cgcontrdp_response_line_tests[i].cid, ==, cid);
+        g_assert_cmpuint (cgcontrdp_response_line_tests[i].bearer_id, ==, bearer_id);
+        g_assert_cmpstr (cgcontrdp_response_line_tests[i].apn, ==, apn);
+        g_assert_cmpstr (cgcontrdp_response_line_tests[i].local_address, ==, local_address);
+        g_assert_cmpstr (cgcontrdp_response_line_tests[i].gateway, ==, gateway);
+        g_assert_cmpstr (cgcontrdp_response_line_tests[i].dns_primary_address, ==, dns_primary_address);
+        g_assert_cmpstr (cgcontrdp_response_line_tests[i].dns_secondary_address, ==, dns_secondary_address);
+    }
+}
+
+typedef struct {
+    const gchar *str;
+    gboolean     has_ipv4;
+    const gchar *ipv4_dns1;
+    const gchar *ipv4_dns2;
+    gboolean     has_ipv6;
+    const gchar *ipv6_dns1;
+    const gchar *ipv6_dns2;
+} CgcontrdpDnsTest;
+
+static const CgcontrdpDnsTest cgcontrdp_dns_tests[] = {
+    /* IPv4 only */
+    {
+        .str       = "+CGCONTRDP: 3,5,\"iotsim.melita.io\",\"10.84.204.114\",\"\",\"212.56.132.20\",\"212.56.129.228\",\"\",\"\",0,0\r\n",
+        .has_ipv4  = TRUE,
+        .ipv4_dns1 = "212.56.132.20",
+        .ipv4_dns2 = "212.56.129.228",
+        .has_ipv6  = FALSE,
+    },
+    /* IPv6 only */
+    {
