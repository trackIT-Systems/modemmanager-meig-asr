+/*****************************************************************************/
+/* Test *AUTHREQ command builder */
+
+typedef struct {
+    guint                cid;
+    MMBearerAllowedAuth  allowed_auth;
+    const gchar         *user;
+    const gchar         *password;
+    const gchar         *cmd;
+} AuthReqCommandTest;
+
+static const AuthReqCommandTest authreq_command_tests[] = {
+    {
+        .cid          = 1,
+        .allowed_auth = MM_BEARER_ALLOWED_AUTH_UNKNOWN,
+        .cmd          = "*AUTHREQ=1,2,\"\",\"\"",
+    },
+    {
+        .cid          = 2,
+        .allowed_auth = MM_BEARER_ALLOWED_AUTH_UNKNOWN,
+        .user         = "user",
+        .password     = "password",
+        .cmd          = "*AUTHREQ=2,2,\"user\",\"password\"",
+    },
+    {
+        .cid          = 3,
+        .allowed_auth = MM_BEARER_ALLOWED_AUTH_NONE,
+        .user         = "user",
+        .cmd          = "*AUTHREQ=3,0,\"user\",\"\"",
+    },
+    {
+        .cid          = 1,
+        .allowed_auth = MM_BEARER_ALLOWED_AUTH_PAP,
+        .user         = "user",
+        .password     = "password",
+        .cmd          = "*AUTHREQ=1,1,\"user\",\"password\"",
+    },
+    {
+        .cid          = 1,
+        .allowed_auth = MM_BEARER_ALLOWED_AUTH_CHAP,
+        .user         = "user",
+        .password     = "password",
+        .cmd          = "*AUTHREQ=1,2,\"user\",\"password\"",
+    },
+    {
+        .cid          = 1,
+        .allowed_auth = MM_BEARER_ALLOWED_AUTH_PAP | MM_BEARER_ALLOWED_AUTH_CHAP,
+        .user         = "user",
+        .password     = "password",
+        .cmd          = "*AUTHREQ=1,1,\"user\",\"password\"",
+    }
+};
+
+static void
+test_authreq (void)
+{
+    guint i;
+
+    for (i = 0; i < G_N_ELEMENTS (authreq_command_tests); i++) {
+        gboolean success;
+        g_autoptr(MMBearerProperties) properties = NULL;
+        g_autofree gchar *cmd                    = NULL;
+        GError           *error                  = NULL;
+
+        properties = mm_bearer_properties_new ();
+        mm_bearer_properties_set_allowed_auth (properties, authreq_command_tests[i].allowed_auth);
+
+        if (authreq_command_tests[i].user)
+            mm_bearer_properties_set_user (properties, authreq_command_tests[i].user);
+        if (authreq_command_tests[i].password)
+            mm_bearer_properties_set_password (properties, authreq_command_tests[i].password);
+
+        success = mm_asr_build_authreq_command (authreq_command_tests[i].cid, properties, &cmd, &error);
+
+        g_assert_no_error (error);
+        g_assert (success);
+        g_assert_cmpstr (cmd, ==, authreq_command_tests[i].cmd);
+    }
+}
+
+/*****************************************************************************/
+
+int
+main (int argc, char **argv)
+{
+    setlocale (LC_ALL, "");
+
+    g_test_init (&argc, &argv, NULL);
+
+    g_test_add_func ("/MM/asr/getip", test_getip);
+    g_test_add_func ("/MM/asr/cgcontrdp_line", test_cgcontrdp_line);
+    g_test_add_func ("/MM/asr/cgcontrdp", test_cgcontrdp);
+    g_test_add_func ("/MM/asr/authreq", test_authreq);
+
+    return g_test_run ();
+}
