+typedef struct {
+    const gchar *str;
+    gboolean     success;
+    gint         error_code;
+    const gchar *local_ipv4_address;
+    const gchar *gateway_ipv4_address;
+    const gchar *local_ipv6_address;
+    const gchar *gateway_ipv6_address;
