+static void
+test_getip (void)
+{
+    guint i;
+
+    for (i = 0; i < G_N_ELEMENTS (getip_response_tests); i++) {
+        gboolean          success;
+        GError           *error                = NULL;
+        g_autofree gchar *local_ipv4_address   = NULL;
+        g_autofree gchar *gateway_ipv4_address = NULL;
+        g_autofree gchar *local_ipv6_address   = NULL;
+        g_autofree gchar *gateway_ipv6_address = NULL;
+        g_autofree gchar *apn                  = NULL;
+
+        success = mm_asr_parse_getip_response (getip_response_tests[i].str,
+                                               &local_ipv4_address,
+                                               &gateway_ipv4_address,
+                                               &local_ipv6_address,
+                                               &gateway_ipv6_address,
+                                               &apn,
+                                               &error);
+        if (getip_response_tests[i].success) {
+            g_assert_no_error (error);
+            g_assert (success);
+        } else {
+            g_assert_error (error, MM_CORE_ERROR, getip_response_tests[i].error_code);
+            g_assert (!success);
+        }
+
+        g_assert_cmpstr (getip_response_tests[i].local_ipv4_address, ==, local_ipv4_address);
+        g_assert_cmpstr (getip_response_tests[i].gateway_ipv4_address, ==, gateway_ipv4_address);
+        g_assert_cmpstr (getip_response_tests[i].local_ipv6_address, ==, local_ipv6_address);
+        g_assert_cmpstr (getip_response_tests[i].gateway_ipv6_address, ==, gateway_ipv6_address);
+        g_assert_cmpstr (getip_response_tests[i].apn, ==, apn);
+    }
+}
