+/*****************************************************************************/
+/* Test +CGCONTRDP responses */
+
+typedef struct {
+    const gchar *line;
+    guint        cid;
+    guint        bearer_id;
+    const gchar *apn;
+    const gchar *local_address;
+    const gchar *gateway;
+    const gchar *dns_primary_address;
+    const gchar *dns_secondary_address;
+} CgcontrdpResponseLineTest;
+
+static const CgcontrdpResponseLineTest cgcontrdp_response_line_tests[] = {
