+G_DEFINE_TYPE_EXTENDED (MMBroadbandModemAsr, mm_broadband_modem_asr, MM_TYPE_BROADBAND_MODEM, 0,
+                        G_IMPLEMENT_INTERFACE (MM_TYPE_IFACE_MODEM, iface_modem_init)
