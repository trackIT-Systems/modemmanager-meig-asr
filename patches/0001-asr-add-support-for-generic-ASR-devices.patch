+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details:
+ *
+ * Copyright (C) 2026 TDT AG
+ */
+
+#include <glib.h>
+#include <gio/gio.h>
+
+#include "mm-modem-helpers.h"
+#include "mm-modem-helpers-asr.h"
+
+/*****************************************************************************/
+/* +GETIP response parser */
+
+static gboolean
+assign_ipv4_or_ipv6 (const gchar  *address,
+                     gchar       **out_ipv4_address,
+                     gchar       **out_ipv6_address,
+                     GError      **error)
+{
+    g_autoptr(GInetAddress)   inet_address = NULL;
+    g_autofree gchar         *normalized_address = NULL;
+    gchar                   **out_address;
+
+    if (!mm_3gpp_normalize_address (address, &normalized_address, error))
+        return FALSE;
+
+    inet_address = g_inet_address_new_from_string (normalized_address);
+    if (!inet_address) {
+        g_set_error (error,
+                     MM_CORE_ERROR,
+                     MM_CORE_ERROR_FAILED,
+                     "Invalid IP address %s",
+                     address);
+        return FALSE;
+    }
+
+    switch (g_inet_address_get_family (inet_address)) {
+    case G_SOCKET_FAMILY_IPV4:
+        out_address = out_ipv4_address;
+        break;
+    case G_SOCKET_FAMILY_IPV6:
+        out_address = out_ipv6_address;
+        break;
+    case G_SOCKET_FAMILY_INVALID:
+    case G_SOCKET_FAMILY_UNIX:
+    default:
+        g_set_error (error,
+                     MM_CORE_ERROR,
+                     MM_CORE_ERROR_FAILED,
+                     "Invalid IP address %s",
+                     address);
+        return FALSE;
+    }
+
+    if (*out_address) {
+        g_set_error (error,
+                     MM_CORE_ERROR,
+                     MM_CORE_ERROR_FAILED,
+                     "IP address of this family has already been assigned");
+        return FALSE;
+    }
+    *out_address = g_steal_pointer (&normalized_address);
+
+    return TRUE;
+}
+
+gboolean
+mm_asr_parse_getip_response (const gchar  *response,
+                             gchar       **out_local_ipv4_address,
+                             gchar       **out_gateway_ipv4_address,
+                             gchar       **out_local_ipv6_address,
+                             gchar       **out_gateway_ipv6_address,
+                             gchar       **out_apn,
+                             GError      **error)
+{
+    g_autofree gchar *first_local_address    = NULL;
+    g_autofree gchar *first_gateway_address  = NULL;
+    g_autofree gchar *second_local_address   = NULL;
+    g_autofree gchar *second_gateway_address = NULL;
+    g_autofree gchar *local_ipv4_address     = NULL;
+    g_autofree gchar *gateway_ipv4_address   = NULL;
+    g_autofree gchar *local_ipv6_address     = NULL;
+    g_autofree gchar *gateway_ipv6_address   = NULL;
+    g_autofree gchar *apn                    = NULL;
+    GError           *inner_error            = NULL;
+    g_autoptr(GRegex) r                      = NULL;
+    g_autoptr(GMatchInfo) match_info         = NULL;
+
+    r = g_regex_new ("\\+GETIP:\\s*"
+                     "(\\d+)"             /* unknown */
+                     ",\\s*([^,]*)"       /* first local */
+                     ",\\s*([^,]*)"       /* first gateway */
+                     "(?:,\\s*([^,]*)"    /* second local */
+                     ",\\s*([^,]*))?"     /* second gateway */
+                     ",\\s*([^,\\r\\n]*)" /* apn */
+                     "(?:\\r\\n)?",
+                     0,
+                     0,
+                     NULL);
+    g_assert (r != NULL);
+
+    g_regex_match_full (r, response, strlen (response), 0, 0, &match_info, &inner_error);
+    if (inner_error) {
+        g_propagate_error (error, inner_error);
+        return FALSE;
+    }
+
+    if (!g_match_info_matches (match_info)) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS, "Couldn't match +GETIP response");
+        return FALSE;
+    }
+
+    first_local_address = mm_get_string_unquoted_from_match_info (match_info, 2);
+    if (first_local_address && !assign_ipv4_or_ipv6 (first_local_address, &local_ipv4_address, &local_ipv6_address, error))
+        return FALSE;
+    first_gateway_address = mm_get_string_unquoted_from_match_info (match_info, 3);
+    if (first_gateway_address && !assign_ipv4_or_ipv6 (first_gateway_address, &gateway_ipv4_address, &gateway_ipv6_address, error))
+        return FALSE;
+
+    second_local_address = mm_get_string_unquoted_from_match_info (match_info, 4);
+    if (second_local_address && !assign_ipv4_or_ipv6 (second_local_address, &local_ipv4_address, &local_ipv6_address, error))
+        return FALSE;
+    second_gateway_address = mm_get_string_unquoted_from_match_info (match_info, 5);
+    if (second_gateway_address && !assign_ipv4_or_ipv6 (second_gateway_address, &gateway_ipv4_address, &gateway_ipv6_address, error))
+        return FALSE;
+
+    apn = mm_get_string_unquoted_from_match_info (match_info, 6);
+
+    if (out_local_ipv4_address)
+        *out_local_ipv4_address = g_steal_pointer (&local_ipv4_address);
+    if (out_gateway_ipv4_address)
+        *out_gateway_ipv4_address = g_steal_pointer (&gateway_ipv4_address);
+    if (out_local_ipv6_address)
+        *out_local_ipv6_address = g_steal_pointer (&local_ipv6_address);
+    if (out_gateway_ipv6_address)
+        *out_gateway_ipv6_address = g_steal_pointer (&gateway_ipv6_address);
+    if (out_apn)
+        *out_apn = g_steal_pointer (&apn);
+    return TRUE;
+}
+
+/*****************************************************************************/
+/* +CGCONTRDP response parser */
+
+gboolean
+mm_asr_parse_cgcontrdp_response_line (const gchar  *response,
+                                      guint        *out_cid,
+                                      guint        *out_bearer_id,
+                                      gchar       **out_apn,
+                                      gchar       **out_local_address,
+                                      gchar       **out_gateway_address,
+                                      gchar       **out_dns_primary_address,
+                                      gchar       **out_dns_secondary_address,
+                                      GError      **error)
+{
+    guint                  cid                      = 0;
+    guint                  bearer_id                = 0;
+    g_autofree gchar      *apn                      = NULL;
+    g_autofree gchar      *local_address            = NULL;
+    g_autofree gchar      *normalized_local_address = NULL;
+    g_autofree gchar      *gateway                  = NULL;
+    g_autofree gchar      *normalized_gateway       = NULL;
+    g_autofree gchar      *dns_primary              = NULL;
+    g_autofree gchar      *normalized_dns_primary   = NULL;
+    g_autofree gchar      *dns_secondary            = NULL;
+    g_autofree gchar      *normalized_dns_secondary = NULL;
+    GError                *inner_error              = NULL;
+    g_autoptr(GRegex)      r                        = NULL;
+    g_autoptr(GMatchInfo)  match_info               = NULL;
+
+    r = g_regex_new ("\\+CGCONTRDP:\\s*"
+                     "(\\d+),(\\d+),([^,]*)" /* cid, bearer id, apn */
+                     "(?:,([^,]*))?"         /* ip */
+                     "(?:,([^,]*))?"         /* gateway */
+                     "(?:,([^,]*))?"         /* dns1 */
+                     "(?:,([^,]*))?"         /* dns2 */
+                     "(?:,(.*))?"            /* others, ignored */
+                     "(?:\\r\\n)?",
+                     0,
+                     0,
+                     NULL);
+    g_assert (r != NULL);
+
+    g_regex_match_full (r, response, strlen (response), 0, 0, &match_info, &inner_error);
+    if (inner_error) {
+        g_propagate_error (error, inner_error);
+        return FALSE;
+    }
+
+    if (!g_match_info_matches (match_info)) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS, "Couldn't match +CGCONTRDP response");
+        return FALSE;
+    }
+
+    if (!mm_get_uint_from_match_info (match_info, 1, &cid)) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "Error parsing cid");
+        return FALSE;
+    }
+
+    if (!mm_get_uint_from_match_info (match_info, 2, &bearer_id)) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "Error parsing bearer id");
+        return FALSE;
+    }
+
+    apn = mm_get_string_unquoted_from_match_info (match_info, 3);
+
+    local_address = mm_get_string_unquoted_from_match_info (match_info, 4);
+    if (local_address && !mm_3gpp_normalize_address (local_address, &normalized_local_address, error))
+        return FALSE;
+
+    gateway = mm_get_string_unquoted_from_match_info (match_info, 5);
+    if (gateway && !mm_3gpp_normalize_address (gateway, &normalized_gateway, error))
+        return FALSE;
+
+    dns_primary = mm_get_string_unquoted_from_match_info (match_info, 6);
+    if (dns_primary && !mm_3gpp_normalize_address (dns_primary, &normalized_dns_primary, error))
+        return FALSE;
+
+    dns_secondary = mm_get_string_unquoted_from_match_info (match_info, 7);
+    if (dns_secondary && !mm_3gpp_normalize_address (dns_secondary, &normalized_dns_secondary, error))
+        return FALSE;
+
+    if (out_cid)
+        *out_cid = cid;
+    if (out_bearer_id)
+        *out_bearer_id = bearer_id;
+    if (out_apn)
+        *out_apn = g_steal_pointer (&apn);
+    if (out_local_address)
+        *out_local_address = g_steal_pointer (&normalized_local_address);
+    if (out_gateway_address)
+        *out_gateway_address = g_steal_pointer (&normalized_gateway);
+    if (out_dns_primary_address)
+        *out_dns_primary_address = g_steal_pointer (&normalized_dns_primary);
+    if (out_dns_secondary_address)
+        *out_dns_secondary_address = g_steal_pointer (&normalized_dns_secondary);
+
+    return TRUE;
+}
+
+gboolean
+mm_asr_cgcontrdp_response_set_dns (const gchar       *response,
+                                   MMBearerIpConfig  *ipv4_config,
+                                   MMBearerIpConfig  *ipv6_config,
+                                   GError           **error)
+{
+    g_auto (GStrv) lines = NULL;
+    guint i;
+
+    lines = g_strsplit_set (response, "\r\n", -1);
+
+    for (i = 0; lines[i]; i++) {
+        MMBearerIpConfig        *ip_config     = NULL;
+        g_autoptr(GInetAddress)  inet_address  = NULL;
+        g_autofree gchar        *local_address = NULL;
+        g_auto (GStrv)           dns_addresses = NULL;
+        gchar                   *line          = lines[i];
+
+        /* skip lines with whitespace only */
+        g_strstrip (line);
+        if (!line[0])
+            continue;
+
+        dns_addresses = g_new0 (gchar *, 3);
+
+        if (!mm_asr_parse_cgcontrdp_response_line (lines[i],
+                                                   NULL, /* cid */
+                                                   NULL, /* bearer_id */
+                                                   NULL, /* apn */
+                                                   &local_address,
+                                                   NULL, /* gateway */
+                                                   &dns_addresses[0],
+                                                   &dns_addresses[1],
+                                                   error)) {
+            return FALSE;
+        }
+
+        inet_address = g_inet_address_new_from_string (local_address);
+        if (!inet_address) {
+            g_set_error (error,
+                         MM_CORE_ERROR,
+                         MM_CORE_ERROR_FAILED,
+                         "Invalid IP address %s",
+                         local_address);
+            return FALSE;
+        }
+
+        switch (g_inet_address_get_family (inet_address)) {
+        case G_SOCKET_FAMILY_IPV4:
+            ip_config = ipv4_config;
+            break;
+        case G_SOCKET_FAMILY_IPV6:
+            ip_config = ipv6_config;
+            break;
+        case G_SOCKET_FAMILY_INVALID:
+        case G_SOCKET_FAMILY_UNIX:
+        default:
+            g_set_error (error,
+                         MM_CORE_ERROR,
+                         MM_CORE_ERROR_FAILED,
+                         "Invalid IP address %s",
+                         local_address);
+            return FALSE;
+        }
+
+        if (!ip_config)
+            /* This IP family was not requested so just ignore it */
+            continue;
+
+        if (mm_bearer_ip_config_get_dns (ip_config)) {
+            g_set_error (error,
+                         MM_CORE_ERROR,
+                         MM_CORE_ERROR_FAILED,
+                         "Received multiple DNS responses of the same IP family");
+            return FALSE;
+        }
+
+        mm_bearer_ip_config_set_dns (ip_config, (const gchar **) dns_addresses);
+    }
+
+    return TRUE;
+}
+
+/*****************************************************************************/
+/* *AUTHREQ set command helper */
+
+gboolean
+mm_asr_build_authreq_command (guint                cid,
+                              MMBearerProperties  *properties,
+                              gchar              **out_cmd,
+                              GError             **error)
+{
+    MMBearerAllowedAuth  allowed_auth;
+    const gchar         *user;
+    const gchar         *password;
+    guint                auth_type;
+    g_autofree gchar    *quoted_user     = NULL;
+    g_autofree gchar    *quoted_password = NULL;
+
+    allowed_auth = mm_bearer_properties_get_allowed_auth (properties);
+    user         = mm_bearer_properties_get_user (properties);
+    password     = mm_bearer_properties_get_password (properties);
+
+    if (allowed_auth == MM_BEARER_ALLOWED_AUTH_UNKNOWN) {
+        /* Default to CHAP auth */
+        auth_type = 2;
+    } else if (allowed_auth == MM_BEARER_ALLOWED_AUTH_NONE) {
+        auth_type = 0;
+    } else if (allowed_auth & MM_BEARER_ALLOWED_AUTH_PAP) {
+        auth_type = 1;
+    } else if (allowed_auth & MM_BEARER_ALLOWED_AUTH_CHAP) {
+        auth_type = 2;
+    } else {
+        g_autofree gchar *auth_str = NULL;
+
+        auth_str = mm_bearer_allowed_auth_build_string_from_mask (allowed_auth);
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_UNSUPPORTED, "Cannot use any of the specified authentication methods (%s)", auth_str);
+        return FALSE;
+    }
+
+    quoted_user     = mm_at_quote_string (user);
+    quoted_password = mm_at_quote_string (password);
+    *out_cmd        = g_strdup_printf ("*AUTHREQ=%u,%u,%s,%s",
+                                cid,
+                                auth_type,
+                                quoted_user,
+                                quoted_password);
+    return TRUE;
+}
