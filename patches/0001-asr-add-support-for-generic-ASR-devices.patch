+    GRegex           *connect_regex;
+};
+
+/*****************************************************************************/
+/* Load current capabilities (Modem interface) */
+static MMModemCapability
+load_current_capabilities_finish (MMIfaceModem *self,
+                                  GAsyncResult *res,
+                                  GError      **error)
+{
+    return g_task_propagate_int (G_TASK (res), error);
+}
+
+static void
+cereg_test_ready (MMBaseModem  *self,
+                  GAsyncResult *res,
+                  GTask        *task)
+{
+    MMModemCapability  caps;
+    GError            *error = NULL;
+
+    caps = GPOINTER_TO_UINT (g_task_get_task_data (task));
+
+    mm_base_modem_at_command_finish (self, res, &error);
+    if (!error)
+        caps |= MM_MODEM_CAPABILITY_LTE;
+    else
+        g_clear_error (&error);
+
+    g_task_return_int (task, caps);
+    g_object_unref (task);
+}
+
+static void
+parent_load_current_capabilities_ready (MMIfaceModem *self,
+                                        GAsyncResult *res,
+                                        GTask        *task)
+{
+    MMModemCapability  caps;
+    GError            *error = NULL;
+
+    caps = iface_modem_parent->load_current_capabilities_finish (
+        self, res, &error);
+
+    if (error) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    if (caps & MM_MODEM_CAPABILITY_LTE) {
+        g_task_return_int (task, caps);
+        g_object_unref (task);
+        return;
+    }
+
+    /* Some ASR devices don't report LTE support by themselves
+       therefore try querying manually */
+    g_task_set_task_data (task, GUINT_TO_POINTER (caps), NULL);
+
+    mm_base_modem_at_command (
+        MM_BASE_MODEM (self),
+        "+CEREG=?",
+        3,
+        TRUE,
+        (GAsyncReadyCallback) cereg_test_ready,
+        task);
+}
+
+static void
+load_current_capabilities (MMIfaceModem        *self,
+                           GAsyncReadyCallback  callback,
+                           gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+
+    iface_modem_parent->load_current_capabilities (
+        self,
+        (GAsyncReadyCallback) parent_load_current_capabilities_ready,
+        task);
+}
+
+/*****************************************************************************/
+/* Bearer creation */
+
+static MMBaseBearer *
+modem_create_bearer_finish (MMIfaceModem  *self,
+                            GAsyncResult  *res,
+                            GError       **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void
+bearer_new_ready (GObject      *source,
+                  GAsyncResult *res,
+                  GTask        *task)
+{
+    MMBaseBearer      *bearer;
+    g_autoptr(GError)  error = NULL;
+
+    bearer = mm_broadband_bearer_asr_new_finish (res, &error);
+    if (!bearer)
+        g_task_return_error (task, g_steal_pointer (&error));
+    else
+        g_task_return_pointer (task, bearer, g_object_unref);
+    g_object_unref (task);
+}
+
+static void
+modem_create_bearer (MMIfaceModem        *self,
+                     MMBearerProperties  *bearer_properties,
+                     GAsyncReadyCallback  callback,
+                     gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+
+    mm_broadband_bearer_asr_new (MM_BROADBAND_MODEM (self),
+                                 MM_BROADBAND_MODEM_ASR (self)->priv->default_ip_method,
+                                 bearer_properties,
+                                 NULL,
+                                 (GAsyncReadyCallback) bearer_new_ready,
+                                 task);
+}
+
+/*****************************************************************************/
+/* Power down */
+
+static gboolean
+modem_power_down_finish (MMIfaceModem  *self,
+                         GAsyncResult  *res,
+                         GError       **error)
+{
+    return !!mm_base_modem_at_command_finish (MM_BASE_MODEM (self), res, error);
+}
+
+static void
+modem_power_down (MMIfaceModem        *self,
+                  GAsyncReadyCallback  callback,
+                  gpointer             user_data)
+{
+    mm_base_modem_at_command (MM_BASE_MODEM (self), "+CFUN=4", 20, FALSE, callback, user_data);
+}
+
+/*****************************************************************************/
+/* Set initial EPS bearer settings (3GPP interface) */
+
+static gboolean
+modem_3gpp_set_initial_eps_bearer_settings_finish (MMIfaceModem3gpp  *self,
+                                                   GAsyncResult      *res,
+                                                   GError           **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+set_initial_eps_authreq_ready (MMBaseModem  *self,
+                               GAsyncResult *res,
+                               GTask        *task)
+{
+    GError *error = NULL;
+
+    if (!mm_base_modem_at_command_finish (self, res, &error))
+        g_task_return_error (task, error);
+    else
+        g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+set_initial_eps_bearer_settings_parent_ready (MMIfaceModem3gpp *self,
+                                              GAsyncResult     *res,
+                                              GTask            *task)
+{
+    MMBearerProperties *bearer_properties;
+    gint                cid;
+    g_autofree gchar   *cmd   = NULL;
+    GError             *error = NULL;
+
+    if (!iface_modem_3gpp_parent->set_initial_eps_bearer_settings_finish (self, res, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    cid = mm_broadband_modem_get_initial_eps_bearer_cid (MM_BROADBAND_MODEM (self));
+    g_assert (cid >= 0);
+
+    bearer_properties = g_task_get_task_data (task);
+    if (!mm_asr_build_authreq_command ((guint) cid, bearer_properties, &cmd, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    mm_obj_dbg (self, "setting initial EPS bearer authentication in context #%d...", cid);
+    mm_base_modem_at_command (MM_BASE_MODEM (self), cmd, 10, FALSE, (GAsyncReadyCallback) set_initial_eps_authreq_ready, task);
+}
+
+static void
+modem_3gpp_set_initial_eps_bearer_settings (MMIfaceModem3gpp    *self,
+                                            MMBearerProperties  *bearer_properties,
+                                            GAsyncReadyCallback  callback,
+                                            gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_set_task_data (task, g_object_ref (bearer_properties), g_object_unref);
+
+    iface_modem_3gpp_parent->set_initial_eps_bearer_settings (
+        self, bearer_properties, (GAsyncReadyCallback) set_initial_eps_bearer_settings_parent_ready, task);
+}
+
+/*****************************************************************************/
+/* Check format (3gppProfileManager interface) */
+
+static gboolean
+modem_3gpp_profile_manager_check_format_finish (MMIfaceModem3gppProfileManager  *_self,
+                                                GAsyncResult                    *res,
+                                                gboolean                        *new_id,
+                                                gint                            *min_profile_id,
+                                                gint                            *max_profile_id,
+                                                GEqualFunc                      *apn_cmp,
+                                                MM3gppProfileCmpFlags           *profile_cmp_flags,
+                                                GError                         **error)
+{
+    gint     asr_min_profile_id;
+    gboolean success;
+
+    success = iface_modem_3gpp_profile_manager_parent->check_format_finish (_self, res, new_id, &asr_min_profile_id, max_profile_id, apn_cmp, profile_cmp_flags, error);
+    if (!success)
+        return FALSE;
+
+    /* +CGDCONT=? reports min id 0, but in reality 0 doesn't work */
+    asr_min_profile_id = MAX (asr_min_profile_id, 1);
+    if (min_profile_id)
+        *min_profile_id = asr_min_profile_id;
+
+    return TRUE;
+}
+
+/*****************************************************************************/
+/* Initialization started (Broadband modem class) */
+
+typedef struct {
+    gpointer parent_context;
+} InitializationContext;
+
+static void
+initialization_context_free (InitializationContext *ctx)
+{
+    g_slice_free (InitializationContext, ctx);
+}
+
+static gpointer
+initialization_started_finish (MMBroadbandModem  *self,
+                               GAsyncResult      *res,
+                               GError           **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void
+dialmode_ready (MMPortSerialAt *port,
+                GAsyncResult   *res,
+                GTask          *task)
+{
+    InitializationContext *ctx;
+    GError                *error = NULL;
+
+    ctx = g_task_get_task_data (task);
+
+    if (!mm_port_serial_at_command_finish (port, res, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    g_task_return_pointer (task, ctx->parent_context, NULL);
+    g_object_unref (task);
+}
+
+static void
+parent_initialization_started_ready (MMBroadbandModem *self,
+                                     GAsyncResult     *res,
+                                     GTask            *task)
+{
+    InitializationContext *ctx;
+    GError                *error = NULL;
+
+    ctx                 = g_task_get_task_data (task);
+    ctx->parent_context = MM_BROADBAND_MODEM_CLASS (mm_broadband_modem_asr_parent_class)->initialization_started_finish (self, res, &error);
+    if (error) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    mm_obj_dbg (self, "turning off autodial...");
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                              "+DIALMODE=1",
+                              20,
+                              FALSE, /* allow cached */
+                              (GAsyncReadyCallback) dialmode_ready,
+                              task);
+}
+
+static void
+initialization_started (MMBroadbandModem    *self,
+                        GAsyncReadyCallback  callback,
+                        gpointer             user_data)
+{
+    InitializationContext *ctx;
+    GTask                 *task;
+
+    ctx = g_slice_new0 (InitializationContext);
+
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_set_task_data (task, ctx, (GDestroyNotify) initialization_context_free);
+
+    MM_BROADBAND_MODEM_CLASS (mm_broadband_modem_asr_parent_class)->initialization_started (self, (GAsyncReadyCallback) parent_initialization_started_ready, task);
+}
+
+/*****************************************************************************/
+/* Load initial EPS bearer cid (Broadband modem class) */
+
+static gint
+load_initial_eps_bearer_cid_finish (MMBroadbandModem  *self,
+                                    GAsyncResult      *res,
+                                    GError           **error)
+{
+    return g_task_propagate_int (G_TASK (res), error);
+}
+
+static void
+load_initial_eps_bearer_cid (MMBroadbandModem    *self,
+                             GAsyncReadyCallback  callback,
+                             gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+
+    g_task_return_int (task, 1);
+    g_object_unref (task);
+}
+
+/*****************************************************************************/
+/* Setup ports (Broadband modem class) */
+
+static void
+set_ignored_unsolicited_events_handlers (MMBroadbandModemAsr *self)
+{
+    MMPortSerialAt *ports[2];
+    guint           i;
+
+    ports[0] = mm_base_modem_peek_port_primary (MM_BASE_MODEM (self));
+    ports[1] = mm_base_modem_peek_port_secondary (MM_BASE_MODEM (self));
+
+    for (i = 0; i < G_N_ELEMENTS (ports); i++) {
+        if (!ports[i])
+            continue;
+
+        mm_port_serial_at_add_unsolicited_msg_handler (ports[i],
+                                                       self->priv->connect_regex,
+                                                       NULL,
+                                                       NULL,
+                                                       NULL);
+    }
+}
+
+static void
+setup_ports (MMBroadbandModem *self)
+{
+    /* Call parent's setup ports first always */
+    MM_BROADBAND_MODEM_CLASS (mm_broadband_modem_asr_parent_class)->setup_ports (self);
+
+    /* Unsolicited messages to always ignore */
+    set_ignored_unsolicited_events_handlers (MM_BROADBAND_MODEM_ASR (self));
+}
+
+/*****************************************************************************/
+
+MMBroadbandModem *
+mm_broadband_modem_asr_new (const gchar  *device,
+                            const gchar  *physdev,
+                            const gchar **drivers,
+                            const gchar  *plugin,
+                            guint16       vendor_id,
+                            guint16       product_id)
+{
+    return MM_BROADBAND_MODEM (
+        g_object_new (MM_TYPE_BROADBAND_MODEM_ASR,
+                      MM_BASE_MODEM_DEVICE,             device,
+                      MM_BASE_MODEM_PHYSDEV,            physdev,
+                      MM_BASE_MODEM_DRIVERS,            drivers,
+                      MM_BASE_MODEM_PLUGIN,             plugin,
+                      MM_BASE_MODEM_VENDOR_ID,          vendor_id,
+                      MM_BASE_MODEM_PRODUCT_ID,         product_id,
+                      MM_BASE_MODEM_DATA_NET_SUPPORTED, TRUE,
+                      MM_BASE_MODEM_DATA_TTY_SUPPORTED, FALSE,
+                      NULL));
+}
+
+static void
+set_property (GObject      *object,
+              guint         prop_id,
+              const GValue *value,
+              GParamSpec   *pspec)
+{
+    MMBroadbandModemAsr *self = MM_BROADBAND_MODEM_ASR (object);
+
+    switch (prop_id) {
+    case PROP_DEFAULT_IP_METHOD:
+        self->priv->default_ip_method = g_value_get_enum (value);
+        break;
+    default:
+        G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+        break;
+    }
+}
+
+static void
+get_property (GObject    *object,
+              guint       prop_id,
+              GValue     *value,
+              GParamSpec *pspec)
+{
+    MMBroadbandModemAsr *self = MM_BROADBAND_MODEM_ASR (object);
+
+    switch (prop_id) {
+    case PROP_DEFAULT_IP_METHOD:
+        g_value_set_enum (value, self->priv->default_ip_method);
+        break;
+    default:
+        G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+        break;
+    }
+}
+
+static void
+mm_broadband_modem_asr_init (MMBroadbandModemAsr *self)
+{
+    /* Initialize private data */
+    self->priv = G_TYPE_INSTANCE_GET_PRIVATE (self,
+                                              MM_TYPE_BROADBAND_MODEM_ASR,
+                                              MMBroadbandModemAsrPrivate);
+
+    self->priv->default_ip_method = MM_BEARER_IP_METHOD_DHCP;
+
+    self->priv->connect_regex = g_regex_new ("\\r\\nCONNECT.*\\r\\n", G_REGEX_RAW | G_REGEX_OPTIMIZE, 0, NULL);
+}
+
+static void
+finalize (GObject *object)
+{
+    MMBroadbandModemAsr *self = MM_BROADBAND_MODEM_ASR (object);
+
+    g_regex_unref (self->priv->connect_regex);
+
+    G_OBJECT_CLASS (mm_broadband_modem_asr_parent_class)->finalize (object);
+}
+
+static void
+iface_modem_init (MMIfaceModemInterface *iface)
+{
+    iface_modem_parent = g_type_interface_peek_parent (iface);
+
+    iface->create_bearer                    = modem_create_bearer;
+    iface->create_bearer_finish             = modem_create_bearer_finish;
+    iface->load_current_capabilities        = load_current_capabilities;
+    iface->load_current_capabilities_finish = load_current_capabilities_finish;
+    iface->modem_power_down                 = modem_power_down;
+    iface->modem_power_down_finish          = modem_power_down_finish;
+}
+
+static void
+iface_modem_3gpp_init (MMIfaceModem3gppInterface *iface)
+{
+    iface_modem_3gpp_parent = g_type_interface_peek_parent (iface);
+
+    iface->set_initial_eps_bearer_settings        = modem_3gpp_set_initial_eps_bearer_settings;
+    iface->set_initial_eps_bearer_settings_finish = modem_3gpp_set_initial_eps_bearer_settings_finish;
+}
+
+static void
+iface_modem_3gpp_profile_manager_init (MMIfaceModem3gppProfileManagerInterface *iface)
+{
+    iface_modem_3gpp_profile_manager_parent = g_type_interface_peek_parent (iface);
+
+    iface->check_format_finish = modem_3gpp_profile_manager_check_format_finish;
+}
+
+static void
+mm_broadband_modem_asr_class_init (MMBroadbandModemAsrClass *klass)
+{
+    GObjectClass          *object_class          = G_OBJECT_CLASS (klass);
+    MMBroadbandModemClass *broadband_modem_class = MM_BROADBAND_MODEM_CLASS (klass);
+
+    g_type_class_add_private (object_class, sizeof (MMBroadbandModemAsrPrivate));
+
+    object_class->get_property = get_property;
+    object_class->set_property = set_property;
+    object_class->finalize     = finalize;
+
+    broadband_modem_class->initialization_started             = initialization_started;
+    broadband_modem_class->initialization_started_finish      = initialization_started_finish;
+    broadband_modem_class->load_initial_eps_bearer_cid        = load_initial_eps_bearer_cid;
+    broadband_modem_class->load_initial_eps_bearer_cid_finish = load_initial_eps_bearer_cid_finish;
+    broadband_modem_class->setup_ports                        = setup_ports;
+
+    properties[PROP_DEFAULT_IP_METHOD] =
+        g_param_spec_enum (MM_BROADBAND_MODEM_ASR_DEFAULT_IP_METHOD,
+                           "Default IP method",
+                           "Default IP Method (static or DHCP) to use.",
+                           MM_TYPE_BEARER_IP_METHOD,
+                           MM_BEARER_IP_METHOD_DHCP,
+                           G_PARAM_READWRITE | G_PARAM_CONSTRUCT_ONLY);
+    g_object_class_install_property (object_class, PROP_DEFAULT_IP_METHOD, properties[PROP_DEFAULT_IP_METHOD]);
+}
