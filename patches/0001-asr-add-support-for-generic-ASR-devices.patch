+static void
+test_cgcontrdp (void)
+{
+    guint i;
+
+    for (i = 0; i < G_N_ELEMENTS (cgcontrdp_dns_tests); i++) {
+        gboolean                     success;
+        GError                      *error       = NULL;
+        g_autoptr(MMBearerIpConfig)  ipv4_config = NULL;
+        g_autoptr(MMBearerIpConfig)  ipv6_config = NULL;
+
+        if (cgcontrdp_dns_tests[i].has_ipv4)
+            ipv4_config = mm_bearer_ip_config_new ();
+        if (cgcontrdp_dns_tests[i].has_ipv6)
+            ipv6_config = mm_bearer_ip_config_new ();
+
+        success = mm_asr_cgcontrdp_response_set_dns (cgcontrdp_dns_tests[i].str,
+                                                     ipv4_config,
+                                                     ipv6_config,
+                                                     &error);
+        g_assert_no_error (error);
+        g_assert (success);
+        if (cgcontrdp_dns_tests[i].has_ipv4) {
+            g_assert_cmpstr (cgcontrdp_dns_tests[i].ipv4_dns1, ==, mm_bearer_ip_config_get_dns (ipv4_config)[0]);
+            g_assert_cmpstr (cgcontrdp_dns_tests[i].ipv4_dns2, ==, mm_bearer_ip_config_get_dns (ipv4_config)[1]);
+        }
+        if (cgcontrdp_dns_tests[i].has_ipv6) {
+            g_assert_cmpstr (cgcontrdp_dns_tests[i].ipv6_dns1, ==, mm_bearer_ip_config_get_dns (ipv6_config)[0]);
+            g_assert_cmpstr (cgcontrdp_dns_tests[i].ipv6_dns2, ==, mm_bearer_ip_config_get_dns (ipv6_config)[1]);
+        }
+    }
+}
