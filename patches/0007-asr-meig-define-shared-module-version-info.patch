diff --git a/src/plugins/meson.build b/src/plugins/meson.build
index 00b51829..0f8cb72e 100644
--- a/src/plugins/meson.build
+++ b/src/plugins/meson.build
@@ -75,6 +75,7 @@ if plugins_shared['asr']
   sources = files(
     'asr/mm-broadband-bearer-asr.c',
     'asr/mm-broadband-modem-asr.c',
+    'asr/mm-shared.c',
   )
   plugins += {'shared-asr': {
     'plugin': false,
@@ -158,6 +159,7 @@ if plugins_shared['meig']
 
   sources = files(
     'meig/mm-broadband-modem-meig-asr.c',
+    'meig/mm-shared.c',
   )
   plugins += {'shared-meig': {
     'plugin': false,
