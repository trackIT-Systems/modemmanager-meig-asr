index 00000000..9269934d
--- /dev/null
+++ b/src/plugins/meig/tests/test-modem-helpers-meig.c
@@ -0,0 +1,93 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details:
+ *
+ * Copyright (C) 2026 TDT AG
+ */
+
+#include <glib.h>
+#include <glib-object.h>
+#include <locale.h>
+
+#include <ModemManager.h>
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-modem-helpers-meig.h"
+
+/*****************************************************************************/
+/* Test +ECMDUP responses */
+
+typedef struct {
+    const gchar *str;
+    guint        ids[16];
+    guint        ids_n;
+} EcmDupResponseTest;
+
+static const EcmDupResponseTest ecmdup_response_tests[] = {
+    {
+        .str   = "+ECMDUP: 1,1,\"IPV4\",0,\"IPV6\"\r\n",
+        .ids   = { 1 },
+        .ids_n = 1,
+    },
+    {
+        .str   = "\r\n+ECMDUP: 1,1,\"IPV4\",0,\"IPV6\"\r\n"
+                 "\r\n+ECMDUP: 2,0,\"IPV4V6\",1,\"IPV4\"\r\n"
+                 "\r\n+ECMDUP: 3,0,\"IPV4\",0,\"IPV6\"\r\n"
+                 "\r\n+ECMDUP: 5,1,\"IPV4\",0,\"IPV6\"\r\n",
+        .ids   = { 1, 2, 3, 5 },
+        .ids_n = 4,
+    },
+    {
+        .str   = "\r\nOK\r\n",
+        .ids_n = 0,
+    },
+    {
+        .str   = "",
+        .ids_n = 0,
+    },
+};
+
+static void
+test_ecmdup (void)
+{
+    guint i;
+
+    for (i = 0; i < G_N_ELEMENTS (ecmdup_response_tests); i++) {
+        gboolean success;
+        guint    j;
+        g_autoptr(GArray)  connection_ids = NULL;
+        GError            *error          = NULL;
+
+        success = mm_meig_parse_ecmdup_response (ecmdup_response_tests[i].str,
+                                                 &connection_ids,
+                                                 &error);
+        g_assert_no_error (error);
+        g_assert (success);
+        g_assert_cmpuint (connection_ids->len, ==, ecmdup_response_tests[i].ids_n);
+        for (j = 0; j < ecmdup_response_tests[i].ids_n; j++)
+            g_assert_cmpuint (ecmdup_response_tests[i].ids[j], ==, g_array_index (connection_ids, guint, j));
+    }
+}
+
+/*****************************************************************************/
+
+int
+main (int argc, char **argv)
+{
+    setlocale (LC_ALL, "");
+
+    g_test_init (&argc, &argv, NULL);
+
+    g_test_add_func ("/MM/meig/ecmdup", test_ecmdup);
+
+    return g_test_run ();
+}
