+ */
+
+#include "ModemManager.h"
+#include <config.h>
+
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-base-modem-at.h"
+#include "mm-broadband-modem-meig-asr.h"
+#include "mm-broadband-modem-asr.h"
+#include "mm-log-object.h"
+#include "mm-modem-helpers-meig.h"
+
+G_DEFINE_TYPE (MMBroadbandModemMeigAsr, mm_broadband_modem_meig_asr, MM_TYPE_BROADBAND_MODEM_ASR)
+
+/*****************************************************************************/
+/* Initialization started (Broadband modem class) */
+
+typedef enum {
+    INITIALIZATION_STEP_FIRST,
+    INITIALIZATION_STEP_NETWORK_CARD_MODE,
+    INITIALIZATION_STEP_LIST_ECMDUP_CONNECTIONS,
+    INITIALIZATION_STEP_DISCONNECT_ECMDUP_CONNECTIONS,
+    INITIALIZATION_STEP_LAST,
+} InitializationStep;
+
+typedef struct {
+    gpointer            parent_context;
+    InitializationStep  step;
+    GArray             *ecmdup_connections;
+    guint               ecmdup_index;
+} InitializationContext;
+
+static void
+initialization_context_free (InitializationContext *ctx)
+{
+    g_clear_pointer (&ctx->ecmdup_connections, g_array_unref);
+    g_slice_free (InitializationContext, ctx);
+}
+
+static gpointer
+initialization_started_finish (MMBroadbandModem  *self,
+                               GAsyncResult      *res,
+                               GError           **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void initialization_step (GTask *task);
+
+static void
+disconnect_ecmdup_connection_ready (MMBaseModem  *modem,
+                                    GAsyncResult *res,
+                                    GTask        *task)
+{
+    InitializationContext *ctx;
+    GError                *error = NULL;
+
+    ctx = g_task_get_task_data (task);
+
+    if (!mm_base_modem_at_command_finish (modem, res, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    /* Do not increment step until all connections are gone */
+    ctx->ecmdup_index++;
+    initialization_step (task);
+}
+
+static void
+list_ecmdup_connections_ready (MMBaseModem  *modem,
+                               GAsyncResult *res,
+                               GTask        *task)
+{
+    MMBroadbandModemMeigAsr *self;
+    InitializationContext   *ctx;
+    const gchar             *response;
+    GError                  *error = NULL;
+
+    self = g_task_get_source_object (task);
+    ctx  = g_task_get_task_data (task);
+
+    response = mm_base_modem_at_command_finish (modem, res, &error);
+    if (!response || !mm_meig_parse_ecmdup_response (response, &ctx->ecmdup_connections, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    mm_obj_dbg (self, "found %u ECMDUP connection(s) to delete", ctx->ecmdup_connections->len);
+    ctx->step++;
+    initialization_step (task);
+}
+
+static void
+dialcfg_ready (MMBaseModem  *modem,
+               GAsyncResult *res,
+               GTask        *task)
+{
+    InitializationContext *ctx;
+    GError                *error = NULL;
+
+    ctx = g_task_get_task_data (task);
+
+    if (!mm_base_modem_at_command_finish (modem, res, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    ctx->step++;
+    initialization_step (task);
+}
+
+static void
+initialization_step (GTask *task)
+{
+    MMBroadbandModemMeigAsr *self;
+    InitializationContext   *ctx;
+    g_autofree gchar        *cmd = NULL;
+
+    self = g_task_get_source_object (task);
+    ctx  = g_task_get_task_data (task);
+
+    switch (ctx->step) {
+    case INITIALIZATION_STEP_FIRST:
+        ctx->step++;
+        /* fall through */
+
+    case INITIALIZATION_STEP_NETWORK_CARD_MODE:
+        mm_obj_dbg (self, "setting network card mode to public network...");
+        mm_base_modem_at_command (MM_BASE_MODEM (self),
+                                  "+DIALCFG=\"DIALMODE\",0",
+                                  30,
+                                  FALSE, /* allow_cached */
+                                  (GAsyncReadyCallback) dialcfg_ready,
+                                  task);
+        return;
+
+    case INITIALIZATION_STEP_LIST_ECMDUP_CONNECTIONS:
+        mm_obj_dbg (self, "listing active ECMDUP connections...");
+        mm_base_modem_at_command (MM_BASE_MODEM (self),
+                                  "+ECMDUP?",
+                                  10,
+                                  FALSE, /* allow_cached */
+                                  (GAsyncReadyCallback) list_ecmdup_connections_ready,
+                                  task);
+        return;
+
+    case INITIALIZATION_STEP_DISCONNECT_ECMDUP_CONNECTIONS:
+        if (ctx->ecmdup_index < ctx->ecmdup_connections->len) {
+            guint id;
+
+            id  = g_array_index (ctx->ecmdup_connections, guint, ctx->ecmdup_index);
+            cmd = g_strdup_printf ("+ECMDUP=%u,0", id);
+            mm_obj_dbg (self, "disconnecting ECMDUP connection %u...", id);
+            mm_base_modem_at_command (MM_BASE_MODEM (self),
+                                      cmd,
+                                      10,
+                                      FALSE, /* allow_cached */
+                                      (GAsyncReadyCallback) disconnect_ecmdup_connection_ready,
+                                      task);
+            return;
+        }
+        ctx->step++;
+        /* fall through */
+
+    case INITIALIZATION_STEP_LAST:
+        g_task_return_pointer (task, ctx->parent_context, NULL);
+        g_object_unref (task);
+        return;
+
+    default:
+        g_assert_not_reached ();
+    }
+}
+
+static void
+parent_initialization_started_ready (MMBroadbandModem *self,
+                                     GAsyncResult     *res,
+                                     GTask            *task)
+{
+    InitializationContext *ctx;
+    GError                *error = NULL;
+
+    ctx                 = g_task_get_task_data (task);
+    ctx->parent_context = MM_BROADBAND_MODEM_CLASS (mm_broadband_modem_meig_asr_parent_class)->initialization_started_finish (self, res, &error);
+    if (error) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    initialization_step (task);
+}
+
+static void
+initialization_started (MMBroadbandModem    *self,
+                        GAsyncReadyCallback  callback,
+                        gpointer             user_data)
+{
+    InitializationContext *ctx;
+    GTask                 *task;
+
+    ctx       = g_slice_new0 (InitializationContext);
+    ctx->step = INITIALIZATION_STEP_FIRST;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_set_task_data (task, ctx, (GDestroyNotify) initialization_context_free);
+
+    MM_BROADBAND_MODEM_CLASS (mm_broadband_modem_meig_asr_parent_class)->initialization_started (self, (GAsyncReadyCallback) parent_initialization_started_ready, task);
+}
+
+/*****************************************************************************/
+
+MMBroadbandModem *
+mm_broadband_modem_meig_asr_new (const gchar  *device,
+                                 const gchar  *physdev,
+                                 const gchar **drivers,
+                                 const gchar  *plugin,
+                                 guint16       vendor_id,
+                                 guint16       product_id)
+{
+    return MM_BROADBAND_MODEM (
+        g_object_new (MM_TYPE_BROADBAND_MODEM_MEIG_ASR,
+                      MM_BASE_MODEM_DEVICE,             device,
+                      MM_BASE_MODEM_PHYSDEV,            physdev,
+                      MM_BASE_MODEM_DRIVERS,            drivers,
+                      MM_BASE_MODEM_PLUGIN,             plugin,
+                      MM_BASE_MODEM_VENDOR_ID,          vendor_id,
+                      MM_BASE_MODEM_PRODUCT_ID,         product_id,
+                      MM_BASE_MODEM_DATA_NET_SUPPORTED, TRUE,
+                      MM_BASE_MODEM_DATA_TTY_SUPPORTED, FALSE,
+                      NULL));
+}
+
+static void
+mm_broadband_modem_meig_asr_init (MMBroadbandModemMeigAsr *self)
+{
+}
+
+static void
+mm_broadband_modem_meig_asr_class_init (MMBroadbandModemMeigAsrClass *klass)
+{
+    MMBroadbandModemClass *broadband_modem_class = MM_BROADBAND_MODEM_CLASS (klass);
+
+    broadband_modem_class->initialization_started        = initialization_started;
+    broadband_modem_class->initialization_started_finish = initialization_started_finish;
+}
