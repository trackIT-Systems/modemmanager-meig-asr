+ */
+
+#include <glib.h>
+
+#include "mm-modem-helpers-meig.h"
+
+/*****************************************************************************/
+/* +ECMDUP response parser */
+
+gboolean
+mm_meig_parse_ecmdup_response (const gchar  *response,
+                               GArray      **out_connection_ids,
+                               GError      **error)
+{
+    GError                *inner_error    = NULL;
+    g_autoptr(GRegex)      r              = NULL;
+    g_autoptr(GMatchInfo)  match_info     = NULL;
+    g_autoptr(GArray)      connection_ids = NULL;
+
+    r = g_regex_new ("\\+ECMDUP:\\s*(\\d+)(?:,[^\\r\\n]*)?",
+                     G_REGEX_RAW,
+                     0,
+                     NULL);
+    g_assert (r != NULL);
+    connection_ids = g_array_new (FALSE, FALSE, sizeof (guint));
+
+    g_regex_match_full (r, response, strlen (response), 0, 0, &match_info, &inner_error);
+    if (inner_error) {
+        g_propagate_error (error, inner_error);
+        return FALSE;
+    }
+
+    while (g_match_info_matches (match_info)) {
+        guint id = 0;
+
+        if (!mm_get_uint_from_match_info (match_info, 1, &id)) {
+            g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "Error parsing +ECMDUP response");
+            return FALSE;
+        }
+        g_array_append_val (connection_ids, id);
+
+        g_match_info_next (match_info, &inner_error);
+        if (inner_error) {
+            g_propagate_error (error, inner_error);
+            return FALSE;
+        }
+    }
+
+    if (out_connection_ids)
+        *out_connection_ids = g_steal_pointer (&connection_ids);
+
+    return TRUE;
+}
